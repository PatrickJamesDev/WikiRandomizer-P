    <string name="tutorialTryRandom">Try it now</string>
    <string name="tutorialWelcomeTitle">Welcome to WikiRandomizer-P</string>
    <string name="tutorialWelcomeBody">A one-minute tour of what makes it fast and fun. You can replay it any time from Settings.</string>
    <string name="tutorialTopicsTitle">Pick your topics</string>
    <string name="tutorialTopicsBody">Choose what you are curious about (science, history, music and more) and WikiRandomizer-P builds a library of matching articles. You can also long-press the shuffle button any time to change them.</string>
    <string name="tutorialRandomTitle">Discover with random</string>
    <string name="tutorialRandomBody">Tap the shuffle button at the bottom to open a random article from your topics. The next one is already being prepared while you read, so it opens instantly.</string>
    <string name="tutorialPullTitle">Pull down for another</string>
    <string name="tutorialPullBody">While reading, pull the article down to jump straight to a new random article.</string>
    <string name="tutorialSwipeTitle">Slide in the menu</string>
    <string name="tutorialSwipeBody">Slide a finger to the right from the left side of the screen to open the menu, without reaching for the button at the top.</string>
    <string name="tutorialTabsTitle">Your tabs on the right</string>
    <string name="tutorialTabsBody">Slide a finger from the right edge of the screen to open your tabs. Hold a link for a second to add its article to your tabs without leaving the page you are reading.</string>
    <string name="tutorialTuneTitle">Teach it your taste</string>
    <string name="tutorialTuneBody">Tap the thumbs up or thumbs down at the bottom to get more or fewer articles like the one you are reading.</string>
    <string name="tutorialMoreTitle">Save, search, share</string>
    <string name="tutorialMoreBody">Save articles for later, search with the bar at the top, switch the article language or share a page. Articles you have already opened load instantly, even offline.</string>
    <string name="tutorialSettingsTitle">Make it yours</string>
    <string name="tutorialSettingsBody">Everything lives in Settings: themes, colours, text size, language, reading history and the topic library. Open it now and take a look; the tour carries on when you come back.</string>
    <string name="tutorialOpenSettings">Open Settings</string>
    <string name="tutorialDoneTitle">You are all set</string>
    <string name="tutorialDoneBody">Enjoy exploring! You can replay this tour from Settings at any time.</string>


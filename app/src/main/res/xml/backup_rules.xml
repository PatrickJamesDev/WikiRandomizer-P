<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: same idea as data_extraction_rules.xml (small data only). -->
<full-backup-content>
    <include domain="database" path="app_database" />
    <!-- Only app_database is included, so everything else (caches, logs, the article library) is already left out. -->
</full-backup-content>

@echo off
setlocal EnableExtensions EnableDelayedExpansion
rem ======================================================================
rem  slim_project.bat - shrink the WikiReader project folder (reversible)
rem
rem  Moves build output, Gradle caches, APKs, logs and leftovers into a new
rem  folder called "extracted_content". NOTHING IS DELETED.
rem
rem  Never touched: app\src, app\schemas, app\build.gradle.kts,
rem  app\proguard-rules.pro, baselineprofile\src, gradle\, gradlew(.bat),
rem  settings.gradle.kts, build.gradle.kts, gradle.properties,
rem  local.properties, fastlane\, weblate\, curators.json and the docs.
rem  The project opens and compiles exactly as before; the first build
rem  afterwards is a full rebuild (libraries come from your global Gradle
rem  cache in %USERPROFILE%\.gradle, which is not touched).
rem
rem  Put this file in the project root (next to settings.gradle.kts).
rem    slim_project.bat            move the files
rem    slim_project.bat /dry       only list what WOULD be moved
rem    slim_project.bat /restore   move everything back
rem ======================================================================

cd /d "%~dp0"
set "ROOT=%CD%"
set "DEST=%ROOT%\extracted_content"

rem ---- option: also move the .idea folder (1 = yes, 0 = no) ----
set "MOVE_IDEA=0"

set "MODE=RUN"
if /i "%~1"=="/dry" set "MODE=DRY"
if /i "%~1"=="/restore" set "MODE=RESTORE"
set "PROBLEMS=0"
set "COUNT=0"

rem ---- sanity check: are we really in the project root? ----
set "OK=1"
if not exist "%ROOT%\settings.gradle.kts" set "OK=0"
if not exist "%ROOT%\gradlew.bat" set "OK=0"
if not exist "%ROOT%\app\build.gradle.kts" set "OK=0"
if not exist "%ROOT%\app\src\main\" set "OK=0"
if "%OK%"=="0" (
  echo.
  echo [ERROR] This does not look like the WikiReader project root.
  echo         Put slim_project.bat next to settings.gradle.kts and run it again.
  echo.
  pause
  exit /b 1
)

if "%MODE%"=="RESTORE" goto :restore

echo.
echo  WikiReader project slimmer
echo  --------------------------
echo  Project : %ROOT%
echo  Moves to: %DEST%
if "%MODE%"=="DRY" echo  Mode    : DRY RUN - nothing will be moved
echo.

if "%MODE%"=="RUN" (
  echo  Please close Android Studio first, so no file is locked.
  echo.
  choice /c YN /n /m "  Continue? [Y/N] "
  if errorlevel 2 goto :cancelled
)

rem ---- length of "ROOT\" so absolute paths can be turned into relative ones ----
set "S=%ROOT%\x"
call :strlen
set /a PFX=LEN-1

call :projsize
set "BEFORE=!SIZE!"

if "%MODE%"=="RUN" if not exist "%DEST%\" mkdir "%DEST%"

echo.
echo  Build output and caches (all regenerated by Gradle)
call :movedir ".gradle"
call :movedir ".kotlin"
call :movedir "build"
call :movedir "app\build"
call :movedir "baselineprofile\build"
call :movedir ".cxx"
call :movedir "app\.cxx"
call :movedir "app\.externalNativeBuild"
call :movedir "captures"
if "%MOVE_IDEA%"=="1" call :movedir ".idea"

echo.
echo  APK / AAB files, logs and temporary leftovers
call :movepatterns
rem  %1 = folder; moves matching loose files in that folder only (no sub-folders)
set "PD=%~1"
if not exist "%PD%\" goto :eof
for %%X in (apk aab ap_ log hprof orig rej bak tmp iml) do (
  for %%F in ("%PD%\*.%%X") do if exist "%%~fF" call :movefile "%%~fF"
)
for %%N in (build_log.txt build_errors.txt) do (
  if exist "%PD%\%%N" call :movefile "%PD%\%%N"
)
goto :eof

:movefile "%%F"
)

rem ---- a second copy of the whole project inside this folder? ----
for /d %%D in ("%ROOT%\*") do (
  if /i not "%%~nxD"=="extracted_content" if exist "%%~fD\settings.gradle.kts" call :nested "%%~fD" "%%~nxD"
)

echo.
echo  ----------------------------------------------------------------
if "%MODE%"=="DRY" (
  echo  Dry run finished. Nothing was moved.
  echo  Run slim_project.bat without /dry to do it.
  goto :end
)

> "%DEST%\README_RESTORE.txt" (
  echo Files moved here by slim_project.bat. Nothing was deleted.
  echo.
  echo To put everything back: run  slim_project.bat /restore  in the project folder.
  echo Or just delete this folder - Gradle recreates the build output on the next build.
  echo.
  echo When you zip the project for sharing, leave this folder out.
)

call :projsize
echo  Project folder size: !BEFORE! MB  to  !SIZE! MB
echo  Moved items are in: %DEST%
if "%PROBLEMS%"=="1" (
  echo.
  echo  [WARNING] Some files could not be moved because they are in use.
  echo            Close Android Studio, run  gradlew --stop  and run this script again.
) else (
  echo.
  echo  Done. In Android Studio use File - Sync Project with Gradle Files,
  echo  then build as usual. The first build takes longer than normal.
)
goto :end


rem ======================================================================
rem  Subroutines
rem ======================================================================

:movedir
rem  %1 = folder relative to the project root; moved with its whole content
set "REL=%~1"
if not exist "%ROOT%\%REL%\" goto :eof
call :dirsize "%ROOT%\%REL%"
if "%MODE%"=="DRY" (
  echo    [dry run] %REL%  - !SIZE! MB
  goto :eof
)
echo    moving %REL%  - !SIZE! MB
robocopy "%ROOT%\%REL%" "%DEST%\%REL%" /E /MOVE /R:1 /W:1 /NFL /NDL /NJH /NJS /NP >nul
if errorlevel 8 (
  echo    [WARNING] could not move all of %REL% - something is using it
  set "PROBLEMS=1"
) else (
  set /a COUNT+=1
)
goto :eof

:movepatterns
rem  %1 = folder; moves matching loose files in that folder only (no sub-folders)
set "PD=%~1"
if not exist "%PD%\" goto :eof
for %%P in (*.apk *.aab *.ap_ *.log *.hprof *.orig *.rej *.bak *.tmp *.iml build_log.txt build_errors.txt) do (
  for %%F in ("%PD%\%%P") do if exist "%%~fF" call :movefile "%%~fF"
)
goto :eof

:movefile
rem  %1 = full path of one file; moved to the same relative path under extracted_content
set "F=%~1"
set "REL=!F:~%PFX%!"
for %%S in ("!F!") do set "FSIZE=%%~zS"
if "%MODE%"=="DRY" (
  echo    [dry run] !REL!  - !FSIZE! bytes
  goto :eof
)
for %%T in ("%DEST%\!REL!") do if not exist "%%~dpT" mkdir "%%~dpT"
move /Y "!F!" "%DEST%\!REL!" >nul
if errorlevel 1 (
  set "PROBLEMS=1"
) else (
  set /a COUNT+=1
  echo    moved !REL!
)
goto :eof

:nested
rem  %1 = full path, %2 = name of a sub-folder that contains another copy of the project
echo.
echo  Found a SECOND copy of the project in the sub-folder: %~2
call :newest "%ROOT%\app\src"
echo    newest source file in this folder : !NEWEST!
call :newest "%~1\app\src"
echo    newest source file in sub-folder  : !NEWEST!
if "%MODE%"=="DRY" goto :eof
echo  Moving the OLDER copy is safe. Moving the newer one hides your latest work
echo  (it still only goes to extracted_content, nothing is deleted).
choice /c YN /d N /t 60 /n /m "  Move the sub-folder %~2 to extracted_content? [y/N] "
if errorlevel 2 goto :eof
call :movedir "%~2"
goto :eof

:strlen
rem  length of variable S is returned in LEN
set "LEN=0"
for %%P in (8192 4096 2048 1024 512 256 128 64 32 16 8 4 2 1) do (
  if not "!S:~%%P,1!"=="" (
    set /a "LEN+=%%P"
    set "S=!S:~%%P!"
  )
)
set /a LEN+=1
goto :eof

:dirsize
rem  %1 = folder; size in MB is returned in SIZE
set "PSP=%~1"
set "PSP=!PSP:'=''!"
set "SIZE=?"
for /f "usebackq delims=" %%S in (`powershell -NoProfile -Command "[math]::Round(((Get-ChildItem -LiteralPath '%PSP%' -Recurse -Force -File -ErrorAction SilentlyContinue | Measure-Object Length -Sum).Sum)/1MB,1)"`) do set "SIZE=%%S"
goto :eof

:projsize
rem  size of the whole project folder without extracted_content, in MB, returned in SIZE
set "PSP=%ROOT%"
set "PSP=!PSP:'=''!"
set "SIZE=?"
for /f "usebackq delims=" %%S in (`powershell -NoProfile -Command "[math]::Round(((Get-ChildItem -LiteralPath '%PSP%' -Recurse -Force -File -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notlike '*\extracted_content\*' } | Measure-Object Length -Sum).Sum)/1MB,1)"`) do set "SIZE=%%S"
goto :eof

:newest
rem  %1 = folder; time of its newest file is returned in NEWEST
set "PSP=%~1"
set "PSP=!PSP:'=''!"
set "NEWEST=unknown"
for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "$f = Get-ChildItem -LiteralPath '%PSP%' -Recurse -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if ($f) { $f.LastWriteTime.ToString('yyyy-MM-dd HH:mm') }"`) do set "NEWEST=%%T"
goto :eof

:restore
if not exist "%DEST%\" (
  echo.
  echo  Nothing to restore: the folder extracted_content does not exist.
  goto :end
)
echo.
echo  This moves everything in extracted_content back to its original place.
choice /c YN /n /m "  Continue? [Y/N] "
if errorlevel 2 goto :cancelled
robocopy "%DEST%" "%ROOT%" /E /MOVE /XF README_RESTORE.txt /R:1 /W:1 /NFL /NDL /NJH /NJS /NP >nul
if errorlevel 8 (
  echo  [WARNING] Some files could not be restored. Close Android Studio and try again.
) else (
  echo  Restored.
)
goto :end

:cancelled
echo.
echo  Cancelled. Nothing was changed.

:end
echo.
pause
endlocal
exit /b 0

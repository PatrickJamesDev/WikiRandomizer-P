rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reading progress is private. No collection-wide reads or writes are allowed; a signed-in
    // user may only touch documents below their own uid.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
